{{> head}}
<body class="min-h-screen relative overflow-hidden bg-[#07150F] text-slate-100">
  <style>
    .login-bg {
      background-image: url('/images/minsu-bg.jpg');
      background-size: cover;
      background-position: center;
      min-height: 100vh;
    }
  </style>

  <header class="fixed left-0 top-0 z-50 w-full border-b border-white/5 bg-slate-950/40 px-8 py-4 backdrop-blur-md">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img src="/images/minsu-logo.png.jpg" alt="Mindoro State University Logo" class="h-14 w-14 rounded-xl border border-white/10 bg-white/5 object-contain p-1" />
        <div class="flex flex-col leading-tight">
          <span class="text-lg font-bold text-white">Mindoro State University</span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-emerald-400">College of Computer Studies</span>
        </div>
      </div>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
        <a href="/" class="text-base font-semibold text-slate-200 transition hover:text-emerald-400">Home</a>
        <a href="/#features" class="text-base font-semibold text-slate-200 transition hover:text-emerald-400">Features</a>
        <a href="/#about" class="text-base font-semibold text-slate-200 transition hover:text-emerald-400">About</a>
        <a href="/#contact" class="text-base font-semibold text-slate-200 transition hover:text-emerald-400">Contact</a>
      </nav>
    </div>
  </header>

  <div class="login-bg relative flex min-h-screen items-center justify-center pt-24">
    <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(6,20,14,0.90),rgba(10,29,21,0.82))]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(34,197,94,0.16),transparent_22%),radial-gradient(circle_at_bottom_right,rgba(34,197,94,0.10),transparent_24%)]"></div>

    <div class="relative z-10 w-full max-w-md px-4">
      <div class="rounded-2xl border-2 border-emerald-400 bg-[#033D2B] p-8 backdrop-blur-xl">
        <div class="mb-6 flex justify-center">
          <img src="/images/ccs-logo.png" alt="CCS Logo" class="h-16 w-16 object-contain drop-shadow-[0_0_18px_rgba(34,197,94,0.35)]" />
        </div>

        <div class="mb-8 text-center">
          <h1 class="mb-1 text-2xl font-extrabold text-white">Welcome to ComLab</h1>
          <p class="mt-3 text-sm text-slate-300">Login to continue to ComLab and access your dashboard.</p>
        </div>

        {{#if error_msg}}
          <div class="mb-5 rounded-xl border border-red-400/25 bg-red-500/10 px-4 py-3 text-sm text-red-200">{{error_msg}}</div>
        {{/if}}
        {{#if success_msg}}
          <div class="mb-5 rounded-xl border border-emerald-400/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">{{success_msg}}</div>
        {{/if}}

        <form class="space-y-5" autocomplete="off" method="POST" action="/login">
          <div>
            <label class="mb-1.5 block text-sm font-medium text-slate-300" for="email">Email Address</label>
            <input id="email" autocomplete="off" type="email" name="email" placeholder="Enter your email" class="w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-3 text-white placeholder-emerald-200/50 transition-all focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300" required />
          </div>

          <div>
            <label class="mb-1.5 block text-sm font-medium text-slate-300" for="password">Password</label>
            <input id="password" autocomplete="off" type="password" name="password" placeholder="Enter your password" class="w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-3 text-white placeholder-emerald-200/50 transition-all focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300" required />
          </div>

          <button type="submit" class="w-full rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-400 px-6 py-3 text-base font-extrabold text-black transition-all hover:bg-emerald-400">Sign in</button>
        </form>

        <div class="mt-6 space-y-3 text-center text-sm">
          <p><a href="/forgot-password" class="font-medium text-emerald-400 transition hover:text-emerald-300">Forgot your password?</a></p>
          <p class="text-slate-300">Don't have an account? <a href="/register" class="font-medium text-emerald-400 transition hover:text-emerald-300">Register now</a></p>
          <p><a href="/" class="font-medium text-emerald-400 transition hover:text-emerald-300">Back to landing</a></p>
        </div>
      </div>
    </div>
  </div>
{{> footer }}