{{> head}}
<body class="min-h-screen bg-[#070f0a]" style="background:radial-gradient(ellipse at 50% 0%,rgba(20,83,45,0.38) 0%,transparent 65%),#070f0a;">

  <div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden">
    <div class="absolute -top-40 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-emerald-900/20 blur-[120px]"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-cyan-900/10 blur-[90px]"></div>
  </div>

  <div class="relative flex min-h-screen items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <div class="rounded-[28px] border border-[rgba(34,197,94,0.18)] bg-[rgba(10,24,18,0.88)] p-8 shadow-[0_24px_70px_rgba(0,0,0,0.5)] backdrop-blur-[18px]">

        <!-- Icon -->
        <div class="mb-6 flex justify-center">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl border border-emerald-500/25 bg-emerald-500/15 shadow-[0_0_30px_rgba(34,197,94,0.15)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
        </div>

        <!-- Title -->
        <div class="mb-6 text-center">
          <h1 class="text-2xl font-bold tracking-tight text-white">Set new password</h1>
          <p class="mt-2 text-sm text-slate-400">Choose a strong password for your account. It must be at least 8 characters.</p>
        </div>

        <!-- Flash messages -->
        {{#if error_msg}}
          <div class="mb-4 rounded-xl border border-red-400/25 bg-red-500/10 px-4 py-3 text-sm text-red-300">{{error_msg}}</div>
        {{/if}}
        {{#if success_msg}}
          <div class="mb-4 rounded-xl border border-emerald-400/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">{{success_msg}}</div>
        {{/if}}

        <form id="resetForm" method="POST" action="/reset-password" autocomplete="off" class="space-y-5">

          <label class="block text-sm font-semibold text-slate-100">
            New password
            <div class="relative mt-2">
              <input
                id="password"
                type="password"
                name="password"
                placeholder="Enter new password"
                required
                minlength="8"
                autocomplete="new-password"
                class="w-full rounded-[16px] border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.06)] px-5 py-3 pr-12 text-white placeholder-slate-500 shadow-[0_4px_16px_rgba(0,0,0,0.2)] outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20"
              />
              <button type="button" onclick="toggleVisibility('password', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 transition-colors" aria-label="Toggle password visibility">
                <svg class="eye-icon h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </button>
            </div>
          </label>

          <label class="block text-sm font-semibold text-slate-100">
            Confirm new password
            <div class="relative mt-2">
              <input
                id="confirmPassword"
                type="password"
                name="confirmPassword"
                placeholder="Repeat new password"
                required
                minlength="8"
                autocomplete="new-password"
                class="w-full rounded-[16px] border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.06)] px-5 py-3 pr-12 text-white placeholder-slate-500 shadow-[0_4px_16px_rgba(0,0,0,0.2)] outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20"
              />
              <button type="button" onclick="toggleVisibility('confirmPassword', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 transition-colors" aria-label="Toggle password visibility">
                <svg class="eye-icon h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </button>
            </div>
          </label>

          <!-- Password strength indicator -->
          <div id="strengthBar" class="hidden">
            <div class="h-1.5 w-full rounded-full bg-slate-700">
              <div id="strengthFill" class="h-1.5 rounded-full transition-all duration-300 bg-red-500" style="width:0%"></div>
            </div>
            <p id="strengthLabel" class="mt-1 text-xs text-slate-500"></p>
          </div>

          <button type="submit"
            class="w-full rounded-[16px] bg-gradient-to-r from-emerald-500 to-cyan-500 px-6 py-3.5 text-sm font-semibold text-slate-950 shadow-[0_12px_28px_rgba(34,197,94,0.25)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_16px_32px_rgba(34,197,94,0.35)]">
            Reset Password
          </button>
        </form>

        <div class="mt-6 text-center text-sm text-slate-500">
          <a href="/login" class="font-semibold text-emerald-400 hover:text-emerald-300 transition-colors">← Back to Login</a>
        </div>

      </div>
    </div>
  </div>

  <script>
    function toggleVisibility(fieldId, btn) {
      const field = document.getElementById(fieldId);
      const isHidden = field.type === 'password';
      field.type = isHidden ? 'text' : 'password';
      btn.setAttribute('aria-pressed', isHidden);
    }

    // Password strength meter
    const passwordInput = document.getElementById('password');
    const strengthBar   = document.getElementById('strengthBar');
    const strengthFill  = document.getElementById('strengthFill');
    const strengthLabel = document.getElementById('strengthLabel');

    const levels = [
      { min: 0,  max: 25,  color: 'bg-red-500',    label: 'Weak' },
      { min: 25, max: 50,  color: 'bg-orange-400',  label: 'Fair' },
      { min: 50, max: 75,  color: 'bg-yellow-400',  label: 'Good' },
      { min: 75, max: 101, color: 'bg-emerald-400', label: 'Strong' },
    ];

    passwordInput.addEventListener('input', () => {
      const val = passwordInput.value;
      if (!val) { strengthBar.classList.add('hidden'); return; }
      strengthBar.classList.remove('hidden');

      let score = 0;
      if (val.length >= 8)  score += 25;
      if (val.length >= 12) score += 10;
      if (/[A-Z]/.test(val)) score += 20;
      if (/[0-9]/.test(val)) score += 20;
      if (/[^A-Za-z0-9]/.test(val)) score += 25;
      score = Math.min(score, 100);

      const lvl = levels.find(l => score >= l.min && score < l.max) || levels[3];
      strengthFill.style.width = score + '%';
      strengthFill.className = `h-1.5 rounded-full transition-all duration-300 ${lvl.color}`;
      strengthLabel.textContent = lvl.label;
    });

    // Client-side match check on submit
    document.getElementById('resetForm').addEventListener('submit', (e) => {
      const pw  = document.getElementById('password').value;
      const cpw = document.getElementById('confirmPassword').value;
      if (pw !== cpw) {
        e.preventDefault();
        alert('Passwords do not match.');
        document.getElementById('confirmPassword').focus();
      }
    });
  </script>

{{> footer}}
